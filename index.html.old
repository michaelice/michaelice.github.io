    <script>
        function togglePatentList() {
            var moreItems = document.querySelectorAll('#patent-list .more-item');
            var btn = document.getElementById('patent-toggle');
            var isHidden = moreItems[0] && moreItems[0].style.display === 'none';
            moreItems.forEach(function(item) {
                item.style.display = isHidden ? '' : 'none';
            });
            btn.textContent = isHidden ? 'Less' : 'More';
        }
        function togglePaperList() {
            var moreItems = document.querySelectorAll('#paper-list .more-item');
            var btn = document.getElementById('paper-toggle');
            var isHidden = moreItems[0] && moreItems[0].style.display === 'none';
            moreItems.forEach(function(item) {
                item.style.display = isHidden ? '' : 'none';
            });
            btn.textContent = isHidden ? 'Less' : 'More';
        }
        // 统计专利和论文数量
        function updateCounts() {
            var patentCount = document.querySelectorAll('#patent-list li').length;
            var paperCount = document.querySelectorAll('#paper-list li').length;
            document.getElementById('patent-count').textContent = '(' + patentCount + ' items)';
            document.getElementById('paper-count').textContent = '(' + paperCount + ' papers)';
        }
        updateCounts();
    </script>
